diff --git a/static/css/admin.css b/static/css/admin.css
new file mode 100644
index 0000000..d86c678
--- /dev/null
+++ b/static/css/admin.css
@@ -0,0 +1,483 @@
+/* หน้า Dashboard ของ Super Admin: ใช้ร่วมกับ retro.css (โหลดผ่าน block extra_css) */
+.site-layout--admin {
+    grid-template-columns: minmax(235px, 265px) minmax(0, 1fr);
+    grid-template-areas: "sidebar content";
+    --slice-1: #3f9f6b;
+    --slice-2: #7b5cf0;
+    --slice-3: #4d7296;
+    --slice-4: #d39b1f;
+    --slice-5: #c2477a;
+}
+
+.site-layout--admin .site-content {
+    display: grid;
+    gap: 0.72rem;
+    align-content: start;
+}
+
+/* ---------- Sidebar menu ---------- */
+.admin-menu__label {
+    margin: 0.6rem 0 0.25rem;
+    color: #653054;
+    font-family: "Courier New", monospace;
+    font-size: 0.68rem;
+    font-weight: 900;
+    letter-spacing: 0.08em;
+    text-transform: uppercase;
+}
+
+.admin-menu__label:first-child { margin-top: 0; }
+
+.admin-menu__link {
+    display: flex;
+    align-items: center;
+    gap: 0.55rem;
+    margin-bottom: 0.25rem;
+    padding: 0.4rem 0.55rem;
+    color: var(--panel-ink);
+    font-size: 0.84rem;
+    text-decoration: none;
+    background: rgb(255 255 255 / 45%);
+    border: 1px solid rgb(78 91 119 / 20%);
+    border-radius: 4px;
+}
+
+.admin-menu__link > span { width: 1rem; color: var(--tse-red); text-align: center; }
+
+.admin-menu__link:hover,
+.admin-menu__link:focus-visible {
+    color: var(--panel-ink);
+    background: #fff;
+    border-color: var(--tse-red);
+}
+
+.admin-menu__link.is-active {
+    color: #fff;
+    font-weight: 700;
+    background: linear-gradient(100deg, var(--tse-red), #763158);
+    border-color: var(--tse-red);
+}
+
+.admin-menu__link.is-active > span { color: var(--tse-yellow); }
+
+.admin-account {
+    display: flex;
+    align-items: center;
+    gap: 0.75rem;
+}
+
+.admin-account .profile-bubble { flex-shrink: 0; margin: 0; }
+
+/* ผู้ใช้ใหม่ วัน/สัปดาห์/เดือน/ปี/ทั้งหมด (ใต้การ์ดชื่อผู้ดูแล) */
+.admin-new-users {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 0.4rem;
+    margin: 0;
+}
+
+.admin-new-users > div {
+    padding: 0.4rem 0.55rem;
+    background: rgb(255 255 255 / 50%);
+    border: 1px solid rgb(78 91 119 / 20%);
+    border-radius: 4px;
+}
+
+.admin-new-users dt {
+    color: #653054;
+    font-family: "Courier New", monospace;
+    font-size: 0.68rem;
+    font-weight: 900;
+}
+
+.admin-new-users dd {
+    margin: 0;
+    color: var(--panel-ink);
+    font-family: var(--display-font);
+    font-size: 1.3rem;
+    line-height: 1.2;
+}
+
+.admin-new-users__all {
+    display: flex;
+    grid-column: 1 / -1;
+    align-items: baseline;
+    justify-content: space-between;
+    color: #fff;
+}
+
+.admin-new-users > .admin-new-users__all {
+    background: linear-gradient(100deg, var(--tse-red), #763158);
+    border-color: var(--tse-red);
+}
+
+.admin-new-users__all dt { color: var(--tse-yellow); }
+.admin-new-users__all dd { color: #fff; }
+
+/* ---------- Stat cards ---------- */
+.admin-stats {
+    display: grid;
+    grid-template-columns: repeat(5, minmax(0, 1fr));
+    gap: 0.72rem;
+}
+
+.admin-stat {
+    display: grid;
+    gap: 0.1rem;
+    padding: 0.8rem 0.9rem;
+    color: var(--panel-ink);
+    text-decoration: none;
+    border-top: 4px solid var(--accent);
+    transition: transform 0.15s ease;
+}
+
+a.admin-stat:hover { color: var(--panel-ink); transform: translateY(-2px); }
+
+.admin-stat__icon {
+    display: grid;
+    place-items: center;
+    width: 34px;
+    height: 34px;
+    margin-bottom: 0.35rem;
+    color: #fff;
+    font-weight: 900;
+    background: var(--accent);
+    border: 2px outset rgb(255 255 255 / 60%);
+    border-radius: 4px;
+}
+
+.admin-stat__value { font-family: var(--display-font); font-size: 1.7rem; line-height: 1.1; }
+.admin-stat__label { color: #505872; font-size: 0.78rem; }
+.admin-stat--red { --accent: var(--tse-red); }
+.admin-stat--violet { --accent: #6b5bb5; }
+.admin-stat--blue { --accent: #4d7296; }
+.admin-stat--green { --accent: #3f9f6b; }
+.admin-stat--amber { --accent: #d39b1f; }
+
+/* ---------- Rows ---------- */
+.admin-row {
+    display: grid;
+    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
+    gap: 0.72rem;
+    align-items: start;
+}
+
+.admin-row .glass-module + .glass-module { margin-top: 0; }
+
+/* ---------- Bar chart (CSS ล้วน) ---------- */
+.admin-bars {
+    display: grid;
+    grid-auto-columns: minmax(0, 1fr);
+    grid-auto-flow: column;
+    gap: 0.6rem;
+    height: 210px;
+    padding-top: 0.5rem;
+}
+
+.admin-bars__col {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: flex-end;
+    min-width: 0;
+}
+
+.admin-bars__count { font-size: 0.75rem; font-weight: 700; }
+
+.admin-bars__bar {
+    width: min(42px, 100%);
+    min-height: 3px;
+    max-height: calc(100% - 2.6rem);
+    background: linear-gradient(180deg, #4d7296, #a9d8ff);
+    border: 1px solid rgb(37 40 58 / 35%);
+    border-radius: 3px 3px 0 0;
+}
+
+.admin-bars__month {
+    width: 100%;
+    margin-top: 0.3rem;
+    padding-top: 0.25rem;
+    color: #505872;
+    font-size: 0.7rem;
+    text-align: center;
+    border-top: 1px solid rgb(37 40 58 / 30%);
+}
+
+/* ---------- Donut ---------- */
+.admin-donut {
+    width: min(170px, 100%);
+    aspect-ratio: 1;
+    margin: 0.25rem auto 0.9rem;
+    border-radius: 50%;
+    -webkit-mask: radial-gradient(circle, transparent 54%, #000 55%);
+    mask: radial-gradient(circle, transparent 54%, #000 55%);
+}
+
+.admin-legend { margin: 0; padding: 0; list-style: none; }
+.admin-legend li { display: flex; align-items: center; gap: 0.45rem; padding: 0.2rem 0; font-size: 0.8rem; }
+.admin-legend strong { margin-left: auto; }
+.admin-dot { width: 9px; height: 9px; border-radius: 50%; }
+
+/* ---------- Table ---------- */
+.admin-table-wrap { overflow-x: auto; }
+.admin-table { width: 100%; font-size: 0.8rem; border-collapse: collapse; }
+
+.admin-table th {
+    padding: 0.4rem 0.5rem;
+    color: #653054;
+    font-family: "Courier New", monospace;
+    font-size: 0.68rem;
+    letter-spacing: 0.06em;
+    text-align: left;
+    text-transform: uppercase;
+    border-bottom: 2px ridge #dce6f4;
+}
+
+.admin-table td { padding: 0.45rem 0.5rem; vertical-align: middle; border-bottom: 1px dashed rgb(78 91 119 / 25%); }
+.admin-table tr:last-child td { border-bottom: 0; }
+
+.admin-person {
+    display: flex;
+    align-items: center;
+    gap: 0.5rem;
+    padding: 0.15rem 0.35rem 0.15rem 0.15rem;
+    color: inherit;
+    font: inherit;
+    text-align: left;
+    background: none;
+    border: 1px solid transparent;
+    border-radius: 999px;
+    cursor: pointer;
+}
+
+.admin-person:hover,
+.admin-person:focus-visible { background: rgb(255 255 255 / 70%); border-color: var(--tse-red); }
+.admin-person small { display: block; color: #505872; font-size: 0.7rem; }
+
+.admin-person__avatar {
+    display: grid;
+    flex-shrink: 0;
+    place-items: center;
+    width: 28px;
+    height: 28px;
+    color: #fff;
+    font-weight: 700;
+    background: linear-gradient(135deg, #4d7296, #8e557d);
+    border-radius: 50%;
+}
+
+.admin-badge {
+    display: inline-block;
+    margin: 1px 2px 1px 0;
+    padding: 0.05rem 0.5rem;
+    color: #505872;
+    font-size: 0.7rem;
+    font-weight: 700;
+    background: rgb(255 255 255 / 60%);
+    border: 1px solid rgb(78 91 119 / 25%);
+    border-radius: 999px;
+}
+
+.admin-badge--red { color: var(--tse-red); border-color: rgb(140 25 28 / 35%); }
+.admin-badge--violet { color: #6b5bb5; border-color: rgb(107 91 181 / 35%); }
+.admin-badge--green { color: #2c7a50; border-color: rgb(63 159 107 / 40%); }
+.admin-badge--amber { color: #9a6a06; border-color: rgb(211 155 31 / 45%); }
+
+/* ---------- Pager (หน้าละ 7 คน) ---------- */
+.admin-pager {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 0.3rem;
+    margin-top: 0.75rem;
+}
+
+.admin-pager__page,
+.admin-pager__gap {
+    display: grid;
+    place-items: center;
+    min-width: 30px;
+    height: 30px;
+    padding: 0 0.4rem;
+    color: var(--panel-ink);
+    font-size: 0.8rem;
+    font-weight: 700;
+    text-decoration: none;
+}
+
+.admin-pager__page {
+    background: rgb(255 255 255 / 55%);
+    border: 2px outset #f8f9ff;
+    border-radius: 4px;
+}
+
+.admin-pager__page:hover { color: var(--panel-ink); border-color: var(--tse-red); }
+
+.admin-pager__page.is-current {
+    color: #fff;
+    background: linear-gradient(100deg, var(--tse-red), #763158);
+    border-style: inset;
+}
+
+/* ---------- User popup (HTML popover ไม่ใช้ JS) ---------- */
+.admin-popup {
+    width: min(440px, calc(100vw - 2rem));
+    padding: 0;
+    margin: auto;
+}
+
+.admin-popup::backdrop { background: rgb(9 9 17 / 65%); }
+.admin-popup .module-heading { display: flex; align-items: center; gap: 0.5rem; }
+.admin-popup .module-heading > span:nth-child(2) { flex: 1; }
+
+.admin-popup__close {
+    padding: 0 0.45rem;
+    color: #fff;
+    font-size: 1.2rem;
+    line-height: 1.3;
+    background: rgb(255 255 255 / 15%);
+    border: 1px solid rgb(255 255 255 / 45%);
+    border-radius: 4px;
+    cursor: pointer;
+}
+
+.admin-facts {
+    display: grid;
+    grid-template-columns: max-content minmax(0, 1fr);
+    gap: 0.4rem 0.9rem;
+    margin: 0;
+    font-size: 0.84rem;
+}
+
+.admin-facts dt {
+    color: #653054;
+    font-family: "Courier New", monospace;
+    font-size: 0.72rem;
+    font-weight: 900;
+}
+
+.admin-facts dd { margin: 0; overflow-wrap: anywhere; }
+
+/* ---------- หน้าจัดการ catalog (รุ่น / วิชา / วิชาในรุ่น) ---------- */
+.admin-title { margin: 0; font: inherit; font-size: 1.05rem; }
+
+.admin-toolbar {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 0.6rem;
+    margin-bottom: 0.8rem;
+}
+
+.admin-hint { margin: 0; color: #505872; font-size: 0.8rem; }
+.admin-hint a,
+.admin-table a:not(.admin-button) { color: var(--tse-red); font-weight: 700; }
+
+.admin-button {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.3rem;
+    padding: 0.3rem 0.75rem;
+    color: var(--panel-ink);
+    font: inherit;
+    font-size: 0.8rem;
+    font-weight: 700;
+    text-decoration: none;
+    white-space: nowrap;
+    background: rgb(255 255 255 / 60%);
+    border: 2px outset #f8f9ff;
+    border-radius: 4px;
+    cursor: pointer;
+}
+
+.admin-button:hover,
+.admin-button:focus-visible { color: var(--panel-ink); background: #fff; border-color: var(--tse-red); }
+.admin-button:active { border-style: inset; }
+
+.admin-button--primary,
+.admin-button--primary:hover,
+.admin-button--primary:focus-visible {
+    color: #fff;
+    background: linear-gradient(100deg, var(--tse-red), #763158);
+}
+
+.admin-button--danger { color: var(--tse-red); }
+
+.admin-actions { display: flex; flex-wrap: wrap; gap: 0.35rem; justify-content: flex-end; }
+.admin-actions form { margin: 0; }
+
+.admin-alert {
+    padding: 0.6rem 0.85rem;
+    color: var(--panel-ink);
+    font-size: 0.85rem;
+    font-weight: 700;
+    background: #e6f4ec;
+    border: 1px solid #3f9f6b;
+    border-left-width: 6px;
+    border-radius: 4px;
+}
+
+.admin-alert--error { background: #fbe6e7; border-color: var(--tse-red); }
+
+/* ฟอร์มบนแผงสีอ่อน: .form-control ของ retro.css ทำไว้สำหรับพื้นมืดหน้า login */
+.admin-form { display: grid; gap: 0.8rem; max-width: 520px; }
+.admin-form__field { display: grid; gap: 0.25rem; }
+.admin-form label { color: #653054; font-size: 0.8rem; font-weight: 800; }
+
+.admin-form input,
+.admin-form select {
+    width: 100%;
+    padding: 0.4rem 0.6rem;
+    color: var(--panel-ink);
+    font: inherit;
+    font-size: 0.9rem;
+    background: #fff;
+    border: 2px inset #dce6f4;
+    border-radius: 4px;
+}
+
+.admin-form input:focus,
+.admin-form select:focus { border-color: var(--tse-red); outline: 2px solid rgb(140 25 28 / 25%); }
+.admin-form .helptext { color: #505872; font-size: 0.72rem; }
+.admin-form .errorlist { margin: 0; color: var(--tse-red); font-size: 0.78rem; font-weight: 700; }
+.admin-form .errorlist.nonfield { padding: 0.5rem 0.75rem; background: #fbe6e7; border: 1px solid var(--tse-red); border-radius: 4px; }
+.admin-form__buttons { display: flex; flex-wrap: wrap; gap: 0.5rem; }
+
+.admin-group + .admin-group { margin-top: 1rem; }
+
+.admin-group__title {
+    display: flex;
+    align-items: baseline;
+    gap: 0.5rem;
+    margin: 0 0 0.35rem;
+    color: var(--panel-ink);
+    font-size: 0.95rem;
+    font-weight: 800;
+}
+
+.admin-group__title small { color: #505872; font-size: 0.75rem; font-weight: 400; }
+
+/* ตัวเลขผู้ใช้/รุ่นในรายการภาควิชา: ของ retro.css เล็กเกินอ่าน (0.48rem) */
+.site-layout--admin .directory-list b { font-size: 0.7rem; }
+
+/* ---------- Responsive ---------- */
+@media (max-width: 1100px) {
+    .admin-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+    .admin-row { grid-template-columns: minmax(0, 1fr); }
+}
+
+@media (max-width: 899.98px) {
+    .site-layout--admin {
+        grid-template-columns: minmax(0, 1fr);
+        grid-template-areas:
+            "sidebar"
+            "content";
+    }
+
+    .site-layout--admin .site-sidebar { grid-template-columns: minmax(0, 1fr); }
+}
+
+@media (max-width: 420px) {
+    .admin-stats { grid-template-columns: minmax(0, 1fr); }
+}
diff --git a/static/css/retro.css b/static/css/retro.css
new file mode 100644
index 0000000..57057c5
--- /dev/null
+++ b/static/css/retro.css
@@ -0,0 +1,4660 @@
+:root {
+    --cyber-black: #090911;
+    --tse-red: #8C191C;
+    --tse-yellow: #FFD04F;
+    --tse-charcoal: #58595B;
+    --chrome-silver: #DDE3EE;
+    --plastic-white: #F8F9FF;
+    --aero-blue: #A9D8FF;
+    --bubblegum-pink: #FF78C8;
+    --acid-lime: #C7FF5E;
+    --iridescent-purple: #A88CFF;
+    --midnight-navy: #111423;
+    --soft-indigo: #1B1F35;
+    --tse-gold: var(--tse-yellow);
+    --soft-pink: var(--bubblegum-pink);
+    --iridescent-violet: var(--iridescent-purple);
+    --liquid-chrome: var(--chrome-silver);
+    --electric-pink: var(--soft-pink);
+    --cyber-violet: var(--iridescent-violet);
+    --ice-blue: var(--aero-blue);
+    --soft-white: var(--plastic-white);
+    --glass-dark: rgb(17 17 29 / 78%);
+    --glass-light: rgb(221 228 244 / 12%);
+    --line-soft: rgb(221 228 244 / 24%);
+    --body-font: "IBM Plex Sans Thai", "Leelawadee UI", "Noto Sans Thai", Tahoma, Arial, sans-serif;
+    --display-font: "Arial Black", "Arial Narrow", Arial, sans-serif;
+    --surface-shadow: 0 28px 65px rgb(0 0 0 / 42%), inset 0 1px 0 rgb(255 255 255 / 20%);
+    --holo-gradient: linear-gradient(115deg, var(--ice-blue), var(--liquid-chrome) 28%, var(--cyber-violet) 56%, var(--electric-pink) 78%, var(--tse-gold));
+}
+
+*,
+*::before,
+*::after {
+    box-sizing: border-box;
+}
+
+html {
+    min-width: 320px;
+    background: var(--cyber-black);
+}
+
+body {
+    min-height: 100vh;
+    margin: 0;
+    overflow-x: hidden;
+    color: var(--soft-white);
+    font-family: var(--body-font);
+    font-size: 0.95rem;
+    line-height: 1.6;
+    background:
+        radial-gradient(circle at 14% 12%, rgb(149 107 255 / 19%), transparent 27rem),
+        radial-gradient(circle at 90% 21%, rgb(255 79 195 / 12%), transparent 25rem),
+        radial-gradient(circle at 70% 86%, rgb(140 25 28 / 22%), transparent 31rem),
+        linear-gradient(145deg, #080810, #11101c 48%, #08080f);
+}
+
+body::before {
+    position: fixed;
+    z-index: -2;
+    inset: 0;
+    content: "";
+    opacity: 0.26;
+    background-image:
+        linear-gradient(rgb(140 235 255 / 15%) 1px, transparent 1px),
+        linear-gradient(90deg, rgb(140 235 255 / 15%) 1px, transparent 1px);
+    background-size: 64px 64px;
+    mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 72%, transparent);
+    transform: perspective(680px) rotateX(63deg) scale(1.7) translateY(15%);
+    transform-origin: center bottom;
+    pointer-events: none;
+}
+
+body::after {
+    position: fixed;
+    z-index: -1;
+    inset: 0;
+    content: "";
+    background:
+        linear-gradient(110deg, transparent 0 49.8%, rgb(248 247 255 / 4%) 50%, transparent 50.2%),
+        radial-gradient(circle at center, transparent 20%, rgb(9 9 17 / 52%) 100%);
+    pointer-events: none;
+}
+
+a {
+    color: var(--ice-blue);
+    text-underline-offset: 0.18em;
+}
+
+a:hover {
+    color: #d8f8ff;
+}
+
+a:focus-visible,
+button:focus-visible,
+input:focus-visible,
+select:focus-visible,
+textarea:focus-visible,
+[tabindex]:focus-visible {
+    outline: 3px solid var(--tse-gold) !important;
+    outline-offset: 4px;
+    box-shadow: 0 0 0 2px var(--cyber-black), 0 0 24px rgb(255 208 79 / 48%) !important;
+}
+
+.skip-link {
+    position: fixed;
+    z-index: 3000;
+    top: 0.75rem;
+    left: 0.75rem;
+    padding: 0.7rem 1rem;
+    color: var(--cyber-black);
+    font-weight: 800;
+    background: var(--tse-gold);
+    border-radius: 999px;
+    transform: translateY(-180%);
+}
+
+.skip-link:focus {
+    color: var(--cyber-black);
+    transform: translateY(0);
+}
+
+.site-frame {
+    position: relative;
+    display: flex;
+    min-height: 100vh;
+    flex-direction: column;
+    isolation: isolate;
+}
+
+.ambient-orb {
+    position: absolute;
+    z-index: -1;
+    width: 26rem;
+    height: 26rem;
+    border-radius: 50%;
+    filter: blur(90px);
+    opacity: 0.16;
+    pointer-events: none;
+}
+
+.ambient-orb--violet {
+    top: 38rem;
+    left: -16rem;
+    background: var(--cyber-violet);
+}
+
+.ambient-orb--red {
+    right: -15rem;
+    bottom: 18rem;
+    background: var(--tse-red);
+}
+
+.site-header {
+    position: relative;
+    z-index: 10;
+    background:
+        linear-gradient(120deg, rgb(9 9 17 / 98%), rgb(26 19 35 / 94%) 48%, rgb(67 15 29 / 72%)),
+        radial-gradient(circle at 75% 30%, rgb(149 107 255 / 28%), transparent 34%);
+    border-bottom: 1px solid rgb(221 228 244 / 12%);
+}
+
+.site-header::before {
+    position: absolute;
+    inset: 0;
+    content: "";
+    opacity: 0.3;
+    background-image:
+        linear-gradient(115deg, transparent 42%, rgb(140 235 255 / 13%) 42.2%, transparent 42.5%),
+        linear-gradient(70deg, transparent 70%, rgb(255 79 195 / 10%) 70.2%, transparent 70.5%);
+    pointer-events: none;
+}
+
+.brand-rail {
+    position: absolute;
+    inset: 0 0 auto;
+    display: grid;
+    height: 5px;
+    grid-template-columns: 18% 1fr 12%;
+}
+
+.brand-rail span:nth-child(1) {
+    background: var(--tse-red);
+}
+
+.brand-rail span:nth-child(2) {
+    background: var(--holo-gradient);
+}
+
+.brand-rail span:nth-child(3) {
+    background: var(--tse-gold);
+}
+
+.site-masthead {
+    position: relative;
+    display: grid;
+    min-height: 176px;
+    grid-template-columns: minmax(0, 1fr) 140px auto;
+    gap: 2rem;
+    align-items: center;
+    padding-top: 2rem;
+    padding-bottom: 2.5rem;
+}
+
+.site-brand {
+    display: inline-flex;
+    max-width: max-content;
+    flex-direction: column;
+    color: var(--soft-white);
+    text-decoration: none;
+}
+
+.site-brand:hover {
+    color: var(--soft-white);
+}
+
+.site-brand__eyebrow,
+.site-brand__tagline {
+    color: var(--liquid-chrome);
+    font-family: Arial, sans-serif;
+    font-size: 0.67rem;
+    font-weight: 700;
+    letter-spacing: 0.26em;
+    text-transform: uppercase;
+}
+
+.site-brand__eyebrow::before {
+    display: inline-block;
+    width: 2.6rem;
+    height: 2px;
+    margin-right: 0.65rem;
+    vertical-align: middle;
+    content: "";
+    background: linear-gradient(90deg, var(--tse-red), var(--tse-gold));
+}
+
+.site-brand__wordmark {
+    display: block;
+    margin: 0.1rem 0 0.2rem;
+    color: transparent;
+    font-family: var(--display-font);
+    font-size: clamp(2.6rem, 7vw, 5.7rem);
+    font-style: italic;
+    font-weight: 900;
+    line-height: 0.9;
+    letter-spacing: -0.075em;
+    text-transform: uppercase;
+    background:
+        linear-gradient(180deg, #ffffff 0%, #dce4f4 28%, #6d7689 43%, #f8f7ff 51%, #a9b3c7 66%, #ffffff 82%, #697185 100%);
+    background-clip: text;
+    filter: drop-shadow(0 4px 0 #3a3f4d) drop-shadow(0 8px 12px rgb(0 0 0 / 60%));
+    -webkit-background-clip: text;
+    -webkit-text-stroke: 1px rgb(248 247 255 / 28%);
+}
+
+.site-brand__tagline {
+    color: rgb(221 228 244 / 72%);
+    letter-spacing: 0.16em;
+}
+
+.masthead-graphic {
+    position: relative;
+    display: grid;
+    width: 116px;
+    height: 116px;
+    place-items: center;
+}
+
+.masthead-graphic__core {
+    display: grid;
+    width: 64px;
+    height: 64px;
+    place-items: center;
+    color: #1a1823;
+    font-family: var(--display-font);
+    font-size: 1rem;
+    font-style: italic;
+    background: radial-gradient(circle at 32% 24%, #ffffff, var(--liquid-chrome) 30%, #777f91 57%, #ffffff 71%, #4e5566);
+    border-radius: 50%;
+    box-shadow: inset -7px -8px 12px rgb(9 9 17 / 32%), 0 0 30px rgb(140 235 255 / 28%);
+}
+
+.masthead-graphic__ring {
+    position: absolute;
+    width: 110px;
+    height: 44px;
+    border: 2px solid var(--ice-blue);
+    border-right-color: var(--electric-pink);
+    border-left-color: var(--tse-gold);
+    border-radius: 50%;
+    transform: rotate(-21deg);
+    box-shadow: 0 0 12px rgb(140 235 255 / 32%);
+}
+
+.masthead-graphic__flare {
+    position: absolute;
+    top: 5px;
+    right: 2px;
+    width: 25px;
+    height: 25px;
+    background: var(--soft-white);
+    clip-path: polygon(44% 0, 56% 0, 60% 40%, 100% 44%, 100% 56%, 60% 60%, 56% 100%, 44% 100%, 40% 60%, 0 56%, 0 44%, 40% 40%);
+    filter: drop-shadow(0 0 8px var(--electric-pink));
+}
+
+.masthead-status {
+    display: flex;
+    align-items: center;
+    gap: 0.6rem;
+    padding: 0.65rem 0.85rem;
+    color: var(--liquid-chrome);
+    font-family: Arial, sans-serif;
+    font-size: 0.65rem;
+    letter-spacing: 0.1em;
+    background: rgb(221 228 244 / 8%);
+    border: 1px solid rgb(221 228 244 / 22%);
+    border-radius: 999px;
+    backdrop-filter: blur(12px);
+}
+
+.masthead-status strong {
+    color: var(--soft-white);
+}
+
+.status-light {
+    width: 8px;
+    height: 8px;
+    background: var(--tse-gold);
+    border-radius: 50%;
+    box-shadow: 0 0 12px var(--tse-gold);
+}
+
+.cyber-nav {
+    position: relative;
+    z-index: 5;
+    margin-bottom: -27px;
+}
+
+.cyber-nav__surface {
+    display: flex;
+    min-height: 58px;
+    align-items: center;
+    justify-content: space-between;
+    gap: 1rem;
+    padding: 0.55rem 0.75rem;
+    background:
+        linear-gradient(110deg, rgb(248 247 255 / 18%), rgb(221 228 244 / 7%) 45%, rgb(149 107 255 / 12%)),
+        rgb(13 13 23 / 78%);
+    border: 1px solid rgb(221 228 244 / 30%);
+    border-radius: 999px;
+    box-shadow: 0 18px 42px rgb(0 0 0 / 38%), inset 0 1px 0 rgb(255 255 255 / 23%);
+    backdrop-filter: blur(22px) saturate(135%);
+}
+
+.cyber-nav__links,
+.cyber-nav__account {
+    display: flex;
+    align-items: center;
+    gap: 0.45rem;
+}
+
+.cyber-nav__account form {
+    margin: 0;
+}
+
+.capsule-link {
+    display: inline-flex;
+    min-height: 42px;
+    align-items: center;
+    gap: 0.5rem;
+    padding: 0.55rem 0.9rem;
+    color: var(--liquid-chrome);
+    font-weight: 700;
+    text-decoration: none;
+    border: 1px solid transparent;
+    border-radius: 999px;
+    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
+}
+
+.capsule-link small {
+    color: rgb(221 228 244 / 48%);
+    font-family: Arial, sans-serif;
+    font-size: 0.56rem;
+    letter-spacing: 0.12em;
+}
+
+.capsule-link__dot {
+    width: 7px;
+    height: 7px;
+    background: var(--chrome-dark, #747d91);
+    border-radius: 50%;
+}
+
+.capsule-link:hover,
+.capsule-link.is-active {
+    color: #ffffff;
+    background: rgb(248 247 255 / 10%);
+    border-color: rgb(221 228 244 / 24%);
+    transform: translateY(-1px);
+}

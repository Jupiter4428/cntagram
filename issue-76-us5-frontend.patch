+      <label for="id_disclaimer">ฉันยืนยันว่าไฟล์นี้ไม่ละเมิดลิขสิทธิ์ของผู้อื่น</label>
+      {% include "materials/_field_errors.html" with errors=form.disclaimer.errors %}
+    </div>
+
+    <button class="upload-submit" type="submit" id="upload-submit" disabled>
+      อัปโหลด <span aria-hidden="true">↗</span>
+    </button>
+  </form>
+</section>
 {% endblock %}
+
+{% block extra_js %}<script src="{% static 'js/upload.js' %}" defer></script>{% endblock %}
